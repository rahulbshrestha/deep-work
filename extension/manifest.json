{
  "manifest_version": 3,
  "name": "Focus Timer",
  "version": "1.0",
  "description": "Click icon to start/pause a focus session. Right-click for history and settings.",
  "action": {
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    },
    "default_title": "Focus Timer — Click to start"
  },
  "background": {
    "service_worker": "bg.js"
  },
  "permissions": ["storage", "alarms", "notifications", "contextMenus"],
  "commands": {
    "toggle-timer": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      },
      "description": "Start or pause the timer"
    },
    "reset-timer": {
      "suggested_key": {
        "default": "Ctrl+Shift+R"
      },
      "description": "Reset the timer"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
